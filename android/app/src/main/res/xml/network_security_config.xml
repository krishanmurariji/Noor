<?xml version="1.0" encoding="utf-8"?>
<!--
  HTTPS everywhere. The one exception is the phone itself: a song plays while
  it downloads through the player's own server inside Noor
  (http://127.0.0.1:<port>, just_audio's StreamAudioSource), which never
  leaves the device. Without it every song not yet saved fails at once with
  "Source error".
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
